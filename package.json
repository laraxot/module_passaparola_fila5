{
  "name": "@laraxot/module-passaparola-assets",
  "private": true,
  "description": "Client JS del modulo Passaparola: widget (public/widget.js, senza build) e assistente operatore (bundle, renderer A2UI del modulo AI caricato a richiesta).",
  "type": "module",
  "scripts": {
    "build": "NODE_PATH=$PWD/node_modules esbuild resources/js/operator-assistant.js --bundle --format=esm --splitting --minify --target=es2020 --legal-comments=external --outdir=public/js --chunk-names=chunks/[name]-[hash]",
    "test": "node --test tests/js/*.test.cjs tests/js/*.test.mjs"
  },
  "dependencies": {
    "@a2ui/lit": "^0.15.0",
    "@a2ui/markdown-it": "^0.2.2",
    "@a2ui/web_core": "^0.15.0",
    "@ag-ui/client": "^1.0.5",
    "chart.js": "^4.5.1",
    "lit": "^3.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0"
  }
}
